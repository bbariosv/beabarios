/* Estilo general */
body { font-family: 'Segoe UI', sans-serif; margin: 0; background: #141414; color: white; }
header { display: flex; justify-content: space-between; padding: 20px; background: #000; }
button { cursor: pointer; padding: 10px; margin: 5px; border-radius: 5px; border: none; }

/* Contenedor Principal */
#display-area { padding: 20px; }

/* MODO CUADRÍCULA (Grid) */
.grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
}

/* MODO LISTA (List) */
.list-layout {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.list-layout .movie-card {
    display: flex;
    align-items: center;
    background: #222;
}
.list-layout .movie-card img { width: 80px; margin-right: 20px; }

/* Tarjeta de película */
.movie-card { background: #2f2f2f; border-radius: 10px; overflow: hidden; transition: 0.3s; }
.movie-card:hover { transform: scale(1.05); border: 2px solid red; }
.movie-card img { width: 100%; display: block; }
.movie-card .info { padding: 10px; }
